<?xml version="1.0" encoding="utf-8"?>
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
    xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
    xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
    IgnorableNamespaces="uap desktop com rescap">
  <Identity
      Name="ReactorWinUIGallery"
      Publisher="CN=ReactorGalleryDev"
      Version="0.1.0.0"
      ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>Reactor WinUI Gallery</DisplayName>
    <PublisherDisplayName>windows-rs</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
    <!-- Self-contained: the package carries the whole Windows App Runtime, so it
         declares no framework dependency. build-msix.ps1 stages every runtime
         DLL, PRI file, language directory, and the XAML resource directory
         beside the executable. A package that carries the runtime but omits its
         language and resource files fails at first layout: XAML cannot load its
         localized resources (ERROR_MUI_FILE_NOT_LOADED, 0x80073B01) and the
         process fail-fasts with a stowed exception (0xC000027B). -->
  </Dependencies>
  <Resources>
    <Resource Language="en-US" />
  </Resources>
  <Applications>
    <Application Id="App" Executable="reactor-gallery.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
          DisplayName="Reactor WinUI Gallery"
          Square150x150Logo="Assets\Square150x150Logo.png"
          Square44x44Logo="Assets\Square44x44Logo.png"
          Description="WinUI 3 gallery built with windows-reactor"
          BackgroundColor="transparent" />
      <Extensions>
        <!-- App notifications need a toast activator CLSID plus a matching COM
             server. Without both, AppNotificationManager::Register() fails with
             "No COM servers are registered for this app" (0x80004005) and the
             toast never shows. The CLSID is this sample's fixed identity; the
             Arguments prefix is the Windows App SDK convention for notification
             activation. Note that ToastActivatorCLSID and com:Class Id take a
             bare GUID, with no braces. -->
        <desktop:Extension Category="windows.toastNotificationActivation">
          <desktop:ToastNotificationActivation ToastActivatorCLSID="2A6E3F51-9B74-4C58-A1D3-7E5F8B0C4A76" />
        </desktop:Extension>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="reactor-gallery.exe"
                           DisplayName="Reactor WinUI Gallery"
                           Arguments="----AppNotificationActivated:">
              <com:Class Id="2A6E3F51-9B74-4C58-A1D3-7E5F8B0C4A76" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <!-- The official WinUI 3 Gallery uses the same full-trust desktop model. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
