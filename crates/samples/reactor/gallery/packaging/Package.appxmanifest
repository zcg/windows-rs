<?xml version="1.0" encoding="utf-8"?>
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
    IgnorableNamespaces="uap rescap">
  <Identity
      Name="ReactorWinUIGallery"
      Publisher="CN=ReactorGalleryDev"
      Version="0.1.0.0"
      ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>Reactor WinUI Gallery</DisplayName>
    <PublisherDisplayName>windows-rs</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
    <!-- Self-contained packaging: the runtime files ship inside the package
         (see build-msix.ps1) and no framework is declared. A
         <PackageDependency> on the Windows App Runtime would put the
         framework into the package graph alongside the packaged files, and
         loading two copies of the runtime fail-fasts in CoreMessagingXP. -->
  </Dependencies>
  <Resources>
    <Resource Language="en-US" />
  </Resources>
  <Applications>
    <Application Id="App" Executable="reactor-gallery.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
          DisplayName="Reactor WinUI Gallery"
          Square150x150Logo="Assets\Square150x150Logo.png"
          Square44x44Logo="Assets\Square44x44Logo.png"
          Description="WinUI 3 gallery built with windows-reactor"
          BackgroundColor="transparent" />
    </Application>
  </Applications>
  <Capabilities>
    <!-- Official WinUI 3 Gallery uses the same full-trust desktop model: no
         webcam capability is declared. Camera access for a runFullTrust
         desktop app is controlled by the system setting
         Settings > Privacy & security > Camera > Let desktop apps access
         your camera (registry ConsentStore\webcam\NonPackaged = Allow). -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
